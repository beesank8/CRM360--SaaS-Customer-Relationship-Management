# Copy this file to .env and fill in real values.
# Never commit your actual .env file (it should be in .gitignore).

PORT=5000

# Local dev: mongodb://127.0.0.1:27017/crm360
# Production: use your real MongoDB connection string
# (e.g. a MongoDB Atlas URI: mongodb+srv://user:pass@cluster.mongodb.net/crm360)
MONGO_URI=mongodb://127.0.0.1:27017/crm360

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# The deployed frontend's URL (used for CORS). Local dev default shown.
CLIENT_URL=http://localhost:5173
