# ============================================================
# LOCAL DEVELOPMENT DEFAULTS ONLY
#
# These values are for running the server on your own machine.
# Do NOT deploy the server with these values unchanged:
#
#   - MONGO_URI below points at a MongoDB instance on
#     127.0.0.1 (i.e. "this same machine"). A deployed server
#     (Render/Railway/EC2/etc.) will look for MongoDB on
#     ITS OWN machine unless you point this at your real
#     database (e.g. a MongoDB Atlas connection string).
#
#   - JWT_SECRET below was freshly generated for this project.
#     Rotate it again before using this in any shared/public
#     repository, and never commit real secrets to git. Use
#     your host's secrets manager / environment variables in
#     production instead of a committed .env file.
#
#   - CLIENT_URL must be set to the deployed frontend's URL in
#     production so CORS allows it.
# ============================================================

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/crm360
JWT_SECRET=995e31e86792d6a6fd9171971afcb136af3c6f6d0644a9adde3e18256c9d8588b99c7b82c47af41dc26bf823c8c530e1065b9ace35ef525706f110136bfb442f
