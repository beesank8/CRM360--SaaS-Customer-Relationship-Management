# ============================================================
# LOCAL DEVELOPMENT DEFAULT
#
# This points the frontend at a backend running on your own
# machine on port 5000. Fine for `npm run dev`.
#
# IMPORTANT FOR DEPLOYMENT:
# Vite bakes VITE_API_URL into the build at build time. Before
# running `npm run build` for a real deployment, change this to
# your deployed backend's public URL, e.g.:
#   VITE_API_URL=https://api.yourdomain.com/api
# Leaving this as localhost means every visitor's browser will
# try to call THEIR OWN computer instead of your server.
# ============================================================

VITE_API_URL=http://localhost:5000/api
